# Copy to .env (deploy/install.sh generates this automatically with random secrets).
DOMAIN=trade.qivynex.com
ACME_EMAIL=
WEB_PORT=8090

POSTGRES_USER=trader
POSTGRES_DB=trading
POSTGRES_PASSWORD=change-me-long-random

# 32+ random characters
SECRET_KEY=change-me-long-random-at-least-32-chars

# First-run administrator (only used while the users table is empty).
INITIAL_ADMIN_USERNAME=abbas
INITIAL_ADMIN_PASSWORD=

# MT5 bridge shared secret (copy the same value into bridge/bridge.env on Windows)
BRIDGE_KEY_ID=mt5-bridge-1
BRIDGE_SECRET=change-me-long-random-at-least-32-chars
# Optional: comma-separated public IPs of the Windows VPS allowed to use the bridge API
BRIDGE_ALLOWED_IPS=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Optional services: caddy (automatic HTTPS), ctrader (cTrader connector). Comma separated.
COMPOSE_PROFILES=

# cTrader Open API connector (run deploy/setup-ctrader.sh to fill these in)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_LOGIN=
CTRADER_SYMBOL_MAP=
CONNECTOR_MAX_VOLUME=0.10
CONNECTOR_MAX_SPREAD_POINTS=30
# Must be true before any order is sent to a real-money account
ALLOW_REAL_ACCOUNT=false

# Capital.com connector (run deploy/setup-capital.sh to fill these in)
CAPITAL_IDENTIFIER=
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_ENV=demo
CAPITAL_ACCOUNT_ID=
CAPITAL_UNITS_PER_SIZE=
CAPITAL_SYMBOL_MAP=
