# Copy to bridge.env (same folder as mt5_bridge.py). Keep this file private.

# Dashboard URL (HTTPS) and the shared secret from the server's .env (BRIDGE_SECRET)
API_URL=https://trade.qivynex.com
BRIDGE_KEY_ID=mt5-bridge-1
BRIDGE_SECRET=

# Optional: path to terminal64.exe if several terminals are installed
MT5_PATH=
# Optional: log in automatically (otherwise the terminal's current login is used)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Broker symbol names if they differ, e.g. EURUSD=EURUSD.m,GBPUSD=GBPUSD.m,USDJPY=USDJPY.m
SYMBOL_MAP=

# Safety limits enforced by the bridge itself (independent of the server)
MAX_VOLUME=0.10
MAX_SPREAD_POINTS=30
# Must be explicitly true before ANY order is sent to a real-money account
ALLOW_REAL_ACCOUNT=false

# Broker server time offset vs UTC in hours, or "auto" (detected from live ticks)
SERVER_UTC_OFFSET_HOURS=auto

MAGIC=724001
LOOP_SECONDS=5
BACKFILL_BARS=5000
